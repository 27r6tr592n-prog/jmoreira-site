# URL canônica do site (sem barra no final). Obrigatória em produção.
NEXT_PUBLIC_SITE_URL=https://jmoreiraassistencia.com.br

# Supabase — opcional. Sem estas variáveis o site usa lib/mock-data.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só no servidor (pedidos, leads, prestadores). Nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago — opcional. Sem o token, o pagamento online fica em modo "pendente".
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
